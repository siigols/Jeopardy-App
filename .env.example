# Copy this file to .env and adjust the values. .env is gitignored.

# Where boards are stored (libSQL / Turso).
#
# In development you can leave this unset: the server falls back to a local file
# at server/jeopardy.db and prints a warning.
#
# In production it is REQUIRED. The server refuses to start without it when
# NODE_ENV=production, because a local file on an ephemeral host is deleted on
# every restart and every board created would be lost.
#
# Local file (dev):
# TURSO_DATABASE_URL=file:./server/jeopardy.db
#
# Hosted Turso (prod) — from `turso db show <name> --url`:
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io

# Auth token for the hosted database, from `turso db tokens create <name>`.
# Not needed for a file: URL.
# TURSO_AUTH_TOKEN=

# Shared secret required to create or edit boards, sent by the client in the
# x-edit-code header. Defaults to "jeopardy" with a startup warning when unset.
# EDIT_CODE=jeopardy

# Port the HTTP + socket server listens on. Defaults to 3001.
# In dev the Vite proxy target is hardcoded to localhost:3001 — changing this also
# requires editing vite.config.ts.
# PORT=3001

# How many reverse-proxy hops to trust, so the edit-code rate limiter keys on the
# real client IP instead of the proxy. Accepts a hop count, true/false, loopback,
# or a comma-separated list of IPs/CIDR ranges. Off by default.
# TRUST_PROXY=1
